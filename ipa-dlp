# ---------------------------------------------------------------------------
# small helpers
# ---------------------------------------------------------------------------


def eprint(*args: Any, **kwargs: Any) -> None:
    kwargs.setdefault("file", sys.stderr)
    print(*args, **kwargs)


def log(message: str) -> None:
    eprint(message)


def vlog(message: str) -> None:
    if VERBOSE:
        eprint(message)


def strip_ansi(text: str) -> str:
    return ANSI_RE.sub("", text)


def tail(text: str, limit: int = 4000) -> str:
    text = strip_ansi(text).strip()
    if len(text) <= limit:
        return text
    return "..." + text[-limit:]


def parse_json(text: str) -> Optional[Dict[str, Any]]:
    """ipatool logs JSON objects, sometimes surrounded by other log lines."""
    if not text:
        return None
    clean = strip_ansi(text)
    for line in reversed(clean.splitlines()):
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            value = json.loads(line)
        except Exception:
            continue
        if isinstance(value, dict):
            return value
    try:
        value = json.loads(clean)
    except Exception:
        return None
    return value if isinstance(value, dict) else None


def run(
    argv: Sequence[Any],
    timeout: int = 300,
    check: bool = True,
    env: Optional[Dict[str, str]] = None,
) -> subprocess.CompletedProcess:
    cmd = [str(item) for item in argv]
    vlog("+ " + " ".join(cmd))
    try:
        completed = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=timeout,
            env=env,
        )
    except FileNotFoundError as exc:
        raise CliError("missing command: %s" % cmd[0]) from exc
    except subprocess.TimeoutExpired as exc:
        raise CliError("command timed out after %ss: %s" % (timeout, cmd[0])) from exc
    if check and completed.returncode != 0:
        detail = tail(completed.stderr or completed.stdout)
        raise CliError(
            "%s failed (exit %s)%s"
            % (cmd[0], completed.returncode, (": " + detail) if detail else "")
        )
    return completed


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def ensure_private_dir(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True)
    try:
        path.chmod(0o700)
    except OSError:
        pass


def write_private(path: Path, data: str) -> None:
    ensure_private_dir(path.parent)
    fd = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(data)
    try:
        path.chmod(0o600)
    except OSError:
        pass


def read_config() -> Dict[str, Any]:
    try:
        value = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else {}
    except Exception:
        return {}


def save_config(config: Dict[str, Any]) -> None:
    write_private(CONFIG_PATH, json.dumps(config, indent=2, sort_keys=True) + "\n")


