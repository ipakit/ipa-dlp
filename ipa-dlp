def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=APP,
        description="Fetch and decrypt personalized App Store IPAs.",
    )
    parser.add_argument("--version", action="version", version="%s %s" % (APP, VERSION))
    parser.add_argument(
        "--no-gui",
        action="store_true",
        help="use the terminal instead of macOS dialogs",
    )
    parser.add_argument("--verbose", action="store_true", help="verbose command logging")
    subparsers = parser.add_subparsers(dest="command", required=True)

    setup = subparsers.add_parser(
        "setup", help="install tools and sign in to the App Store"
    )
    setup.add_argument("--update", action="store_true", help="reinstall pinned tools")
    setup.add_argument("--reauth", action="store_true", help="force a new login")
    setup.add_argument("--seed", help="optional app to warm the FairPlay model now")
    setup.add_argument("--version", dest="version", help="version for --seed")
    setup.add_argument(
        "--purchase",
        action="store_true",
        help="allow obtaining a missing license for --seed",
    )
    setup.add_argument("--platform", default=DEFAULT_PLATFORM)
    setup.set_defaults(func=cmd_setup)

    get = subparsers.add_parser("get", help="download and decrypt an app")
    get.add_argument("query", help="app name, bundle ID, or App Store ID")
    get.add_argument("--version", help="exact app version, e.g. 9.1.88")
    get.add_argument("--external-version-id", help="skip version lookup with an App Store external version ID")
    get.add_argument("-o", "--output", help="output IPA path")
    get.add_argument("--platform", default=DEFAULT_PLATFORM)
    get.add_argument(
        "--keep-account-data",
        action="store_true",
        help="keep SC_Info licenses and account fields (default: strip them)",
    )
    get.add_argument(
        "--full",
        action="store_true",
        help="also keep the encrypted IPA and decryption report",
    )
    get.add_argument("--force", action="store_true")
    get.add_argument(
        "--purchase",
        action="store_true",
        help="obtain a license if missing (free apps are automatic)",
    )
    get.add_argument("--dry-run", action="store_true")
    get.add_argument("--reveal", action="store_true")
    get.set_defaults(func=cmd_get)

    decrypt = subparsers.add_parser(
        "decrypt", help="decrypt an IPA already downloaded to this Mac"
    )
    decrypt.add_argument("ipa")
    decrypt.add_argument("-o", "--output")
    decrypt.add_argument(
        "--keep-account-data",
        action="store_true",
        help="keep SC_Info licenses and account fields (default: strip them)",
    )
    decrypt.add_argument(
        "--full",
        action="store_true",
        help="keep the decryption report next to the output",
    )
    decrypt.add_argument("--force", action="store_true")
    decrypt.add_argument("--reveal", action="store_true")
    decrypt.set_defaults(func=cmd_decrypt)

    status = subparsers.add_parser("status", help="show tools, account, and model state")
    status.set_defaults(func=cmd_status)

    wizard = subparsers.add_parser("wizard", help="popup-driven app picker")
    wizard.set_defaults(func=cmd_wizard)

    return parser


def main(argv: Optional[Sequence[str]] = None) -> int:
    global USE_GUI, VERBOSE
    if sys.version_info < (3, 9):
        eprint("error: Python 3.9 or newer is required")
        return 1
    parser = build_parser()
    args = parser.parse_args(argv)
    USE_GUI = not args.no_gui
    VERBOSE = bool(args.verbose)
    if os.geteuid() == 0:
        eprint(
            "error: run ipa-dlp as your normal user; "
            "it asks for admin only when needed"
        )
        return 1
    ensure_private_dir(DATA_DIR)
    ensure_private_dir(CACHE_DIR)
    try:
        return int(args.func(args))
    except Cancelled:
        eprint("canceled")
        return 130
    except CliError as exc:
        eprint("error: %s" % exc)
        return 1
    except EOFError:
        eprint("canceled (no input)")
        return 130
    except KeyboardInterrupt:
        eprint("interrupted")
        return 130


if __name__ == "__main__":
    sys.exit(main())
