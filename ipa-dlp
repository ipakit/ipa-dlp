def cmd_setup(args: argparse.Namespace) -> int:
    ensure_tools(update=args.update)
    info = ensure_auth(force=args.reauth)
    log("account: %s" % (info.get("email") or info.get("name") or "unknown"))

    if args.seed:
        log("warming the FairPlay model with %r" % args.seed)
        app = resolve_app(args.seed, args.platform)
        external_id = ""
        if args.version:
            external_id, _ = resolve_version(str(app.get("id")), args.version)
        work = Path(tempfile.mkdtemp(prefix="ipa-dlp-seed-"))
        try:
            ipa = work / "App.ipa"
            seed_purchase = args.purchase or app_is_free(app)
            confirm_purchase(app, seed_purchase)
            downloaded = download_ipa(
                app,
                external_id,
                args.platform,
                ipa,
                purchase=seed_purchase,
            )
            app_path, app_root = extract_app(ipa)
            try:
                ensure_model(ipa, downloaded, app_path)
            finally:
                shutil.rmtree(app_root, ignore_errors=True)
        finally:
            shutil.rmtree(work, ignore_errors=True)
        log("FairPlay model is ready")
    else:
        state = doctor()
        if state and (
            state.get("decrypt_ready")
            or (state.get("checks") or {}).get("model_valid")
        ):
            log("FairPlay model is ready")
        else:
            log(
                "no FairPlay model yet; it will be created automatically on "
                "the first `ipa-dlp get`, with one admin prompt"
            )

    log("")
    log("Installed and authenticated. Try:")
    log("  ipa-dlp get spotify")
    log("  ipa-dlp get spotify --version 9.1.88")
    return 0


def get_flow(
    query: str,
    version: str,
    output: Optional[str],
    keep_account_data: bool = False,
    force: bool = False,
    external_version_id: str = "",
    platform_name: str = DEFAULT_PLATFORM,
    dry_run: bool = False,
    reveal: bool = False,
    purchase: bool = False,
    full_output: bool = False,
) -> Path:
    ensure_tools()
    ensure_auth()

    app = resolve_app(query, platform_name)
    app_id = str(app.get("id", ""))
    log(
        "app: %s [%s] id=%s"
        % (app.get("name", "?"), app.get("bundleID", "?"), app_id)
    )

    external_id = external_version_id.strip()
    metadata: Dict[str, Any] = {}
    if version and not external_id:
        external_id, metadata = resolve_version(app_id, version)
        log(
            "version: %s (external id %s)"
            % (metadata.get("displayVersion", version), external_id)
        )

    if dry_run:
        log("dry run: would download and decrypt this app")
        return Path(output or "")

    work = Path(tempfile.mkdtemp(prefix="ipa-dlp-get-"))
    try:
        ipa = work / "App.ipa"
        purchase = purchase or app_is_free(app)
        confirm_purchase(app, purchase)
        if purchase:
            log("obtaining a free App Store license if needed")
        info = download_ipa(app, external_id, platform_name, ipa, purchase)
        log("downloaded: %s %s" % (info.get("name"), info.get("version")))
        if version and info.get("version") != version:
            raise CliError(
                "downloaded version %s does not match requested %s"
                % (info.get("version"), version)
            )
        destination = Path(output).expanduser() if output else default_output(info)
        if full_output:
            artifact = encrypted_path(destination)
            if artifact.exists() and not force:
                raise CliError(
                    "encrypted IPA already exists (use --force): %s" % artifact
                )
        report = decrypt_ipa(
            ipa,
            info,
            destination,
            keep_account_data=keep_account_data,
            force=force,
            full_output=full_output,
        )
        if full_output:
            artifact = encrypted_path(destination)
            shutil.copyfile(str(ipa), str(artifact))
            artifact.chmod(0o600)
    finally:
        shutil.rmtree(work, ignore_errors=True)

    print(str(destination))
    eprint("decrypted IPA: %s" % destination)
    eprint("verified: %s" % ("yes" if report.get("PlaintextVerified") else "no"))
    if keep_account_data:
        eprint("account data stripped: no (kept by request)")
    else:
        eprint("account data stripped: yes")
    if full_output:
        eprint("encrypted IPA: %s" % encrypted_path(destination))
        eprint("report: %s" % report_path(destination))
    eprint("done.")
    if reveal:
        subprocess.run(["open", "-R", str(destination)], check=False)
    return destination


def cmd_get(args: argparse.Namespace) -> int:
    get_flow(
        args.query,
        args.version or "",
        args.output,
        keep_account_data=args.keep_account_data,
        force=args.force,
        external_version_id=args.external_version_id or "",
        platform_name=args.platform,
        dry_run=args.dry_run,
        reveal=args.reveal,
        purchase=args.purchase,
        full_output=args.full,
    )
    return 0


def cmd_decrypt(args: argparse.Namespace) -> int:
    ensure_tools()
    ipa = Path(args.ipa).expanduser()
    if not ipa.exists():
        raise CliError("IPA not found: %s" % ipa)
    info = read_ipa_info(ipa)
    destination = (
        Path(args.output).expanduser() if args.output else default_output(info)
    )
    report = decrypt_ipa(
        ipa,
        info,
        destination,
        keep_account_data=args.keep_account_data,
        force=args.force,
        full_output=args.full,
    )
    print(str(destination))
    eprint("decrypted IPA: %s" % destination)
    eprint("verified: %s" % ("yes" if report.get("PlaintextVerified") else "no"))
    if args.keep_account_data:
        eprint("account data stripped: no (kept by request)")
    else:
        eprint("account data stripped: yes")
    if args.full:
        eprint("report: %s" % report_path(destination))
    eprint("done.")
    if args.reveal:
        subprocess.run(["open", "-R", str(destination)], check=False)
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    ensure_tools()
    info = auth_info()
    state = doctor()
    print("ipa-dlp %s" % VERSION)
    print("ipatool:    %s (%s)" % (ipatool_path(), tool_version(ipatool_path())))
    print("unfairplay: %s (%s)" % (unfairplay_path(), tool_version(unfairplay_path())))
    print("account:    %s" % ((info or {}).get("email") or "not signed in"))
    print("models:     %s" % MODEL_DIR)
    model_ready = bool(
        state
        and (
            state.get("decrypt_ready")
            or (state.get("checks") or {}).get("model_valid")
        )
    )
    print("decrypt:    %s" % ("model ready" if model_ready else "setup on first get"))
    print("data:       %s" % DATA_DIR)
    print("cache:      %s" % CACHE_DIR)
    return 0


def cmd_wizard(args: argparse.Namespace) -> int:
    ensure_tools()
    ensure_auth()
    config = read_config()
    query = ask_text(
        "ipa-dlp",
        "App name, bundle ID, or App Store ID:",
        default=str(config.get("last_app", "")),
    )
    version = ask_text(
        "ipa-dlp",
        "Version (leave blank for latest):",
        allow_empty=True,
    ).strip()
    try:
        destination = get_flow(
            query,
            version,
            None,
            keep_account_data=False,
            force=False,
            external_version_id="",
            platform_name=DEFAULT_PLATFORM,
            dry_run=False,
            reveal=True,
            purchase=False,
            full_output=False,
        )
        config["last_app"] = query
        save_config(config)
        if gui_enabled():
            osa(
                r"""
on run argv
    display dialog (item 1 of argv) with title "ipa-dlp" buttons {"OK"} default button "OK"
end run
""",
                "Decrypted and account-stripped IPA:\n\n%s" % destination,
            )
        return 0
    except Cancelled:
        raise
    except CliError as exc:
        if gui_enabled():
            try:
                osa(
                    r"""
on run argv
    display alert "ipa-dlp" message (item 1 of argv) as critical buttons {"OK"} default button "OK"
end run
""",
                    str(exc),
                )
            except Exception:
                pass
        raise


