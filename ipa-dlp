def confirm_purchase(app: Dict[str, Any], purchase: bool) -> None:
    if not purchase or app_is_free(app):
        return
    if not ask_yes_no(
        "ipa-dlp",
        "This is a paid app. --purchase may charge your Apple ID. Continue?",
    ):
        raise Cancelled()


def app_is_free(app: Dict[str, Any]) -> bool:
    value = app.get("price")
    if value is None:
        return False
    try:
        return float(value) == 0.0
    except (TypeError, ValueError):
        return str(value).strip() in ("0", "0.00", "Free")


def run_with_progress(
    argv: Sequence[Any],
    watch: Optional[Path],
    label: str,
    timeout: int = 1800,
) -> Tuple[int, str]:
    cmd = [str(item) for item in argv]
    vlog("+ " + " ".join(cmd))
    log_fd, log_name = tempfile.mkstemp(prefix="ipa-dlp-run-", suffix=".log")
    os.close(log_fd)
    log_path = Path(log_name)
    started = time.time()
    last_report = 0.0
    try:
        with log_path.open("wb") as log_file:
            process = subprocess.Popen(
                cmd,
                stdout=log_file,
                stderr=subprocess.STDOUT,
                env=os.environ.copy(),
            )
            while process.poll() is None:
                if time.time() - started > timeout:
                    process.kill()
                    raise CliError("%s timed out" % label)
                now = time.time()
                if now - last_report >= (2 if sys.stderr.isatty() else 15):
                    last_report = now
                    if watch is not None and watch.exists():
                        megabytes = watch.stat().st_size / (1024 * 1024)
                        eprint(
                            "%s: %.1f MB (%.0fs)"
                            % (label, megabytes, now - started)
                        )
                    else:
                        eprint("%s: %.0fs" % (label, now - started))
                time.sleep(0.5)
        output = log_path.read_text(encoding="utf-8", errors="replace")
        return process.returncode, output
    finally:
        log_path.unlink(missing_ok=True)


def download_ipa(
    app: Dict[str, Any],
    external_id: str,
    platform_name: str,
    destination: Path,
    purchase: bool = False,
) -> Dict[str, Any]:
    app_id = str(app.get("id", ""))
    cmd: List[Any] = [
        ipatool_path(),
        "download",
        "-i",
        app_id,
        "-o",
        str(destination),
        "--non-interactive",
    ]
    if purchase:
        cmd.append("--purchase")
    if external_id:
        cmd.extend(["--external-version-id", external_id])
    if platform_name:
        cmd.extend(["--platform", platform_name])

    code, output = run_with_progress(
        cmd, destination, "downloading IPA", timeout=1800
    )
    parsed = parse_json(output)
    if code != 0 or (parsed and parsed.get("success") is False):
        raise CliError(
            "ipatool download failed (exit %s): %s" % (code, tail(output))
        )
    if not destination.exists() or destination.stat().st_size < 1024:
        raise CliError("download produced no IPA: %s" % tail(output))
    destination.chmod(0o600)
    return read_ipa_info(destination)


def read_ipa_info(ipa: Path) -> Dict[str, Any]:
    try:
        archive = zipfile.ZipFile(str(ipa))
    except Exception as exc:
        raise CliError("not a readable IPA: %s" % ipa) from exc
    with archive:
        names = archive.namelist()
        infos = [
            name
            for name in names
            if re.fullmatch(r"Payload/[^/]+\.app/Info\.plist", name)
        ]
        if len(infos) != 1:
            raise CliError(
                "IPA must contain exactly one root app (found %d)" % len(infos)
            )
        info_member = infos[0]
        root = info_member[: -len("/Info.plist")]
        data = archive.read(info_member)
        try:
            info = plistlib.loads(data)
        except Exception as exc:
            raise CliError("could not parse app Info.plist") from exc
        executable = str(info.get("CFBundleExecutable") or "")
        if not executable:
            raise CliError("app Info.plist has no CFBundleExecutable")
        sinf = "%s/SC_Info/%s.sinf" % (root, executable)
        if sinf not in names:
            raise CliError("IPA has no root SINF at %s" % sinf)
        name = (
            info.get("CFBundleDisplayName")
            or info.get("CFBundleName")
            or info.get("CFBundleIdentifier")
            or "App"
        )
        return {
            "path": str(ipa),
            "root": root,
            "bundle_id": str(info.get("CFBundleIdentifier") or ""),
            "name": str(name),
            "version": str(info.get("CFBundleShortVersionString") or ""),
            "build": str(info.get("CFBundleVersion") or ""),
            "executable": executable,
            "minimum_os": str(info.get("MinimumOSVersion") or ""),
            "sinf": sinf,
        }


def extract_app(ipa: Path) -> Tuple[Path, Path]:
    root = Path(tempfile.mkdtemp(prefix="ipa-dlp-ipa-"))
    completed = run(["ditto", "-x", "-k", ipa, root], timeout=600, check=False)
    if completed.returncode != 0:
        shutil.rmtree(root, ignore_errors=True)
        raise CliError("could not unpack IPA: %s" % tail(completed.stderr))
    apps = [
        item
        for item in (root / "Payload").glob("*.app")
        if item.is_dir() and (item / "Info.plist").exists()
    ]
    if len(apps) != 1:
        shutil.rmtree(root, ignore_errors=True)
        raise CliError("IPA payload has %d root apps" % len(apps))
    return apps[0], root


